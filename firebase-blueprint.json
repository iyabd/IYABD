{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An item available for sale in the shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the product." },
        "price": { "type": "number", "description": "Regular price in BDT." },
        "salePrice": { "type": "number", "description": "Discounted price in BDT." },
        "stock": { "type": "number", "description": "Available quantity." },
        "category": { "type": "string", "description": "Category name." },
        "description": { "type": "string", "description": "Full product description." },
        "images": { "type": "array", "items": { "type": "string" }, "description": "List of image URLs." },
        "active": { "type": "boolean", "description": "Whether the product is visible to customers." },
        "featured": { "type": "boolean", "description": "Whether to highlight on home page." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "stock", "category", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "Delivered", "Cancelled"] },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "phone", "address", "items", "total", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "count": { "type": "number" }
      },
      "required": ["name"]
    },
    "Config": {
      "title": "Config",
      "description": "Global shop settings.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "logo": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "bkash": { "type": "string" },
        "nagad": { "type": "string" },
        "rocket": { "type": "string" },
        "address": { "type": "string" },
        "deliveryChargeInside": { "type": "number" },
        "deliveryChargeOutside": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of all products."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of product categories."
    },
    "/settings/config": {
      "schema": "Config",
      "description": "Global shop configuration."
    }
  }
}
